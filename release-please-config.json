{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "dev-config",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "eslint/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "prettier/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "tsconfig/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "include-component-in-tag": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Changes"
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Chores",
      "hidden": true
    }
  ]
}
