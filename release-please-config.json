{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "dev-config",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "eslint/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "prettier/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "tsconfig/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "include-component-in-tag": false,
  "pull-request-footer": "**Merging this yourself is fine, and releases now rather than tonight** — the tag is created by the run your merge starts. It skips one thing: this pull request is otherwise merged by the release workflow, and only after it has checked that nothing changes but version lines and the changelog. That check does not run when a person merges, and anyone with write access can push this branch, so read the diff first.",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Changes"
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Chores",
      "hidden": true
    }
  ]
}
